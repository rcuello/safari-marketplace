root = true

# LF en todo el repo (US-72, DA-2 b), en línea con `.gitattributes`
# (`* text=auto eol=lf`): los editores guardan LF aunque git use autocrlf.
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4

# Dos espacios al final de una línea son un salto de línea duro en Markdown.
[*.md]
trim_trailing_whitespace = false

[justfile]
indent_size = 4
