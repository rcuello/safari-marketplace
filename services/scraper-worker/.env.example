# Copia este archivo a .env  (`just db-up` ya lo hace por ti)
#
# Cadena de conexión a Postgres. La que viene por defecto apunta a la base
# local que levanta docker-compose.yml en la raíz del repo.
#
# Formato: postgresql://usuario:clave@host:puerto/basededatos
DATABASE_URL=postgresql://safari:safari@localhost:5433/safari_scraper
