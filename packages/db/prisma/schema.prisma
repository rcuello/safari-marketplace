// =====================================================================
// safari-marketplace — schema Prisma del catálogo.
//
// GENERADO por `prisma db pull` contra la base real y REVISADO a mano
// (nombres de modelos/campos/relaciones). La fuente de verdad del DDL
// sigue siendo db/schema.sql, aplicado por `just db-migrate`. Este
// archivo NO genera migraciones: si db/schema.sql cambia, se re-hace
// `prisma db pull` y se re-aplican los renombres. Ver el README.
//
// Lo que Prisma NO modela (y por eso vive solo en db/schema.sql):
//   · CHECK constraints: products_rebaja_valida (sale_price < price),
//     products_simple_con_precio (simple ⇒ price NOT NULL),
//     products_procedencia_completa (source_store y source_product_id
//     van juntos o ninguno), products_status_check, categories_no_
//     autoreferencia, settings_fila_unica, become_seller_fila_unica,
//     faqs_faq_type_check (∈ global|shop), terms_and_conditions_type_check
//     (∈ global|shop), refund_policies_target_check (∈ vendor|customer),
//     refund_policies_status_check (∈ approved|pending), taxes_rate_check
//     (rate ≥ 0), shippings_amount_check (amount ≥ 0), shippings_type_check
//     (∈ fixed|percentage|free), store_notices_priority_check (∈ high|
//     medium|low), store_notices_type_check (∈ all_vendor|specific_vendor|
//     all_shop|specific_shop), store_notices_vigencia_valida
//     (effective_from <= expired_at), coupons_type_check (∈ fixed|
//     percentage|free_shipping), coupons_amount_check (amount ≥ 0),
//     coupons_minimum_cart_amount_check (≥ 0), coupons_vigencia_valida
//     (expire_at > active_from), reviews_rating_check (1..5),
//     reviews_photos_check (json_typeof = 'array'), reviews_positive_/
//     negative_feedbacks_count_check (≥ 0), abusive_reports_model_type_
//     check (∈ Review|Question), abusive_reports_message_check
//     (length > 0), questions_question_check (length > 0),
//     questions_positive_/negative_feedbacks_count_check (≥ 0),
//     messages_body_check (length(btrim(body)) > 0). Los repositorios los validan
//     antes de escribir y traducen la violación a errores de dominio.
//   · El índice de expresión products_nombre_trgm_idx
//     (gin (lower(name) gin_trgm_ops)) que acelera la búsqueda por
//     nombre con `contains/insensitive`. Igual questions_question_trgm_idx
//     (gin (lower(question) gin_trgm_ops)) para la búsqueda de preguntas
//     (US-55).
//   · El índice único parcial de expresión users_email_lower_idx
//     (unique btree (lower(email))): garantiza el email case-insensitive
//     (US-20). `User.email` por eso NO lleva `@unique` aquí — el
//     `$queryRaw` de `findUserCredentialsByEmail` es lo único que lo
//     ejercita (ver users.repository.ts).
//   · El índice único de expresión reviews_autor_producto_orden_key
//     (unique (user_id, product_id, COALESCE(order_id, 0))): una reseña
//     por compra y una sin orden por producto (US-54). Su P2002 lo traduce
//     reviews.repository.ts; como users_email_lower_idx, migrate diff no
//     lo acusa como drift.
//   · El índice único PARCIAL products_procedencia_key sí aparece abajo,
//     pero solo gracias al preview feature "partialIndexes" que la
//     introspección activó. No quitar el preview: sin él Prisma trataría
//     el unique como total y `prisma validate` acusaría drift.
// =====================================================================

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma/client"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Setting {
  id        Int      @id @default(1) @db.SmallInt
  options   Json
  language  String   @default("es")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}

model Type {
  id        BigInt   @id @default(autoincrement())
  name      String
  slug      String   @unique
  icon      String?
  settings  Json     @default("{}")
  banners   Json     @default("[]")
  language  String   @default("es")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  categories    Category[]
  manufacturers Manufacturer[]
  products      Product[]
  tags          Tag[]

  @@map("types")
}

model Shop {
  id          BigInt   @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  ownerId     BigInt   @default(1) @map("owner_id")
  isActive    Boolean  @default(true) @map("is_active")
  logo        Json?
  coverImage  Json?    @map("cover_image")
  address     Json     @default("{}")
  settings    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  owner              User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  products           Product[]
  staff              ShopStaff[]
  faqs               Faq[]
  termsAndConditions TermsAndConditions[]
  refundPolicies     RefundPolicy[]
  attributes         Attribute[]
  storeNotices       StoreNoticeShop[]
  coupons            Coupon[]
  reviews            Review[]
  questions          Question[]
  conversations      Conversation[]

  @@map("shops")
}

model Category {
  id        BigInt   @id @default(autoincrement())
  name      String
  slug      String   @unique
  icon      String?
  details   String?
  image     Json?
  parentId  BigInt?  @map("parent_id")
  typeId    BigInt   @map("type_id")
  language  String   @default("es")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onUpdate: NoAction)
  children Category[] @relation("CategoryTree")
  type     Type       @relation(fields: [typeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products CategoryProduct[]

  @@index([parentId], map: "categories_parent_idx")
  @@index([typeId], map: "categories_type_idx")
  @@map("categories")
}

model Manufacturer {
  id          BigInt   @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  website     String?
  image       Json?
  typeId      BigInt?  @map("type_id")
  isApproved  Boolean  @default(true) @map("is_approved")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  type     Type?     @relation(fields: [typeId], references: [id], onUpdate: NoAction)
  products Product[]

  @@map("manufacturers")
}

model Tag {
  id        BigInt   @id @default(autoincrement())
  name      String
  slug      String   @unique
  details   String?
  icon      String?
  image     Json?
  typeId    BigInt?  @map("type_id")
  language  String   @default("es")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  type     Type?        @relation(fields: [typeId], references: [id], onUpdate: NoAction)
  products ProductTag[]

  @@map("tags")
}

model Product {
  id                  BigInt    @id @default(autoincrement())
  name                String
  slug                String    @unique
  description         String    @default("")
  typeId              BigInt    @map("type_id")
  shopId              BigInt    @map("shop_id")
  manufacturerId      BigInt?   @map("manufacturer_id")
  productType         String    @default("simple") @map("product_type")
  price               Decimal?  @db.Decimal(12, 2)
  salePrice           Decimal?  @map("sale_price") @db.Decimal(12, 2)
  minPrice            Decimal?  @map("min_price") @db.Decimal(12, 2)
  maxPrice            Decimal?  @map("max_price") @db.Decimal(12, 2)
  quantity            Int       @default(0)
  inStock             Boolean   @default(true) @map("in_stock")
  soldQuantity        Int       @default(0) @map("sold_quantity")
  sku                 String?
  unit                String    @default("1 pc")
  status              String    @default("publish")
  visibility          String    @default("visibility_public")
  image               Json?
  gallery             Json      @default("[]")
  ratings             Decimal   @default(0) @db.Decimal(3, 2)
  totalReviews        Int       @default(0) @map("total_reviews")
  isTaxable           Boolean   @default(false) @map("is_taxable")
  isDigital           Boolean   @default(false) @map("is_digital")
  isExternal          Boolean   @default(false) @map("is_external")
  externalProductUrl  String?   @map("external_product_url")
  language            String    @default("es")
  translatedLanguages String[]  @default(["es"]) @map("translated_languages")
  sourceStore         String?   @map("source_store")
  sourceProductId     String?   @map("source_product_id")
  sourceUrl           String?   @map("source_url")
  scrapedAt           DateTime? @map("scraped_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id], onUpdate: NoAction)
  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  type         Type          @relation(fields: [typeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  categories   CategoryProduct[]
  tags         ProductTag[]
  wishlists    Wishlist[]
  reviews      Review[]
  questions    Question[]

  @@unique([sourceStore, sourceProductId], map: "products_procedencia_key", where: raw("(source_store IS NOT NULL)"))
  @@index([manufacturerId], map: "products_manufacturer_idx")
  @@index([price], map: "products_precio_idx")
  @@index([scrapedAt(sort: Desc)], map: "products_scraped_idx")
  @@index([shopId], map: "products_shop_idx")
  @@index([typeId, id], map: "products_visibles_idx", where: raw("((status = 'publish'::text) AND (visibility = 'visibility_public'::text))"))
  @@map("products")
}

model CategoryProduct {
  productId  BigInt @map("product_id")
  categoryId BigInt @map("category_id")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([productId, categoryId])
  @@index([categoryId], map: "category_product_categoria_idx")
  @@map("category_product")
}

model ProductTag {
  productId BigInt @map("product_id")
  tagId     BigInt @map("tag_id")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([productId, tagId])
  @@index([tagId], map: "product_tag_tag_idx")
  @@map("product_tag")
}

// =====================================================================
// Identidad (US-20/US-21). Sembrada por db/seed.sql; sirve las 6 tablas
// del Épico 19. `PasswordResetToken` y `OtpCode` entran como MODELOS
// para que el gate de drift (`prisma migrate diff --exit-code`) cierre
// en 0 — sus REPOSITORIOS llegan en US-24, no en esta US: no son un
// olvido.
// =====================================================================

model User {
  id              BigInt    @id @default(autoincrement())
  name            String
  email           String
  passwordHash    String    @map("password_hash")
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  profile             Profile?
  permissions         PermissionUser[]
  passwordResetTokens PasswordResetToken[]
  shops               Shop[]
  staffShops          ShopStaff[]
  faqs                Faq[]
  termsAndConditions  TermsAndConditions[]
  createdStoreNotices StoreNotice[]         @relation("StoreNoticeCreator")
  updatedStoreNotices StoreNotice[]         @relation("StoreNoticeUpdater")
  storeNotices        StoreNoticeUser[]
  storeNoticeReads    StoreNoticeRead[]
  coupons             Coupon[]
  wishlists           Wishlist[]
  reviews             Review[]
  abusiveReports      AbusiveReport[]
  questions           Question[]
  conversations       Conversation[]
  messages            Message[]

  @@map("users")
}

model Profile {
  userId        BigInt   @id @map("user_id")
  avatar        Json?
  bio           String?
  socials       Json?
  contact       String?
  notifications Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("profiles")
}

model Permission {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique
  guardName String   @default("api") @map("guard_name")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  users PermissionUser[]

  @@map("permissions")
}

model PermissionUser {
  userId       BigInt   @map("user_id")
  permissionId BigInt   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, permissionId])
  @@index([permissionId], map: "permission_user_permiso_idx")
  @@map("permission_user")
}

/// Modelo presente para que el gate de drift cierre; su repositorio
/// llega en US-24 (no consumido por esta US).
model PasswordResetToken {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @map("user_id")
  token      String    @unique
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "password_reset_tokens_user_idx")
  @@map("password_reset_tokens")
}

/// Modelo presente para que el gate de drift cierre; su repositorio
/// llega en US-24 (no consumido por esta US).
model OtpCode {
  id         BigInt    @id @default(autoincrement())
  phone      String
  code       String
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone], map: "otp_codes_phone_idx")
  @@map("otp_codes")
}

// =====================================================================
// Identidad extendida (US-41)
// =====================================================================

model ShopStaff {
  userId    BigInt   @map("user_id")
  shopId    BigInt   @map("shop_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, shopId])
  @@index([shopId], map: "shop_staff_tienda_idx")
  @@map("shop_staff")
}

model BecomeSeller {
  id          Int      @id @default(1) @db.SmallInt
  pageOptions Json     @map("page_options")
  commissions Json
  language    String   @default("es")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("become_seller")
}

// =====================================================================
// Contenido (US-47, Épico 46)
// =====================================================================

model Faq {
  id             BigInt   @id @default(autoincrement())
  faqTitle       String   @map("faq_title")
  slug           String   @unique
  faqDescription String   @map("faq_description")
  faqType        String   @map("faq_type")
  issuedBy       String   @map("issued_by")
  shopId         BigInt?  @map("shop_id")
  userId         BigInt?  @map("user_id")
  language       String   @default("es")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user User? @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([shopId], map: "faqs_shop_idx")
  @@index([userId], map: "faqs_user_idx")
  @@map("faqs")
}

model TermsAndConditions {
  id          BigInt   @id @default(autoincrement())
  title       String
  slug        String   @unique
  description String
  type        String
  issuedBy    String   @map("issued_by")
  isApproved  Boolean  @default(false) @map("is_approved")
  shopId      BigInt?  @map("shop_id")
  userId      BigInt?  @map("user_id")
  language    String   @default("es")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user User? @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([shopId], map: "terms_and_conditions_shop_idx")
  @@index([userId], map: "terms_and_conditions_user_idx")
  @@map("terms_and_conditions")
}

// =====================================================================
// Reembolsos (US-48, Épico 46)
// =====================================================================

model RefundPolicy {
  id          BigInt   @id @default(autoincrement())
  title       String
  slug        String   @unique
  description String?
  target      String
  status      String   @default("pending")
  shopId      BigInt?  @map("shop_id")
  language    String   @default("es")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([shopId], map: "refund_policies_shop_idx")
  @@map("refund_policies")
}

model RefundReason {
  id        BigInt   @id @default(autoincrement())
  name      String
  slug      String   @unique
  language  String   @default("es")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("refund_reasons")
}

// =====================================================================
// Configuración fiscal y de envío (US-49, Épico 46)
// =====================================================================

model Tax {
  id         BigInt   @id @default(autoincrement())
  name       String
  rate       Decimal  @db.Decimal
  isGlobal   Boolean  @default(true) @map("is_global")
  country    String?
  state      String?
  zip        String?
  city       String?
  priority   Int?
  onShipping Boolean  @default(true) @map("on_shipping")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("taxes")
}

model Shipping {
  id        BigInt   @id @default(autoincrement())
  name      String
  amount    Decimal  @db.Decimal
  isGlobal  Boolean  @default(true) @map("is_global")
  type      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("shippings")
}

// =====================================================================
// Atributos de producto (US-50, Épico 46)
// =====================================================================

model Attribute {
  id        BigInt   @id @default(autoincrement())
  name      String
  slug      String   @unique
  shopId    BigInt   @map("shop_id")
  language  String   @default("es")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  values AttributeValue[]
  shop   Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([shopId], map: "attributes_shop_idx")
  @@map("attributes")
}

model AttributeValue {
  id          BigInt   @id @default(autoincrement())
  attributeId BigInt   @map("attribute_id")
  value       String
  slug        String
  meta        String?
  language    String   @default("es")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([attributeId, slug])
  @@map("attribute_values")
}

// =====================================================================
// Avisos de tienda (US-51, Épico 46)
// =====================================================================

model StoreNotice {
  id            BigInt    @id @default(autoincrement())
  priority      String
  notice        String
  description   String?
  effectiveFrom DateTime? @map("effective_from") @db.Timestamptz(6)
  expiredAt     DateTime  @map("expired_at") @db.Timestamptz(6)
  type          String
  createdBy     BigInt    @map("created_by")
  updatedBy     BigInt?   @map("updated_by")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  creator    User              @relation("StoreNoticeCreator", fields: [createdBy], references: [id], onUpdate: NoAction)
  updater    User?             @relation("StoreNoticeUpdater", fields: [updatedBy], references: [id], onUpdate: NoAction)
  recipients StoreNoticeUser[]
  shops      StoreNoticeShop[]
  reads      StoreNoticeRead[]

  @@index([createdBy])
  @@index([updatedBy])
  @@map("store_notices")
}

model StoreNoticeUser {
  storeNoticeId BigInt   @map("store_notice_id")
  userId        BigInt   @map("user_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  storeNotice StoreNotice @relation(fields: [storeNoticeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([storeNoticeId, userId])
  @@index([userId], map: "store_notice_user_usuario_idx")
  @@map("store_notice_user")
}

model StoreNoticeShop {
  storeNoticeId BigInt   @map("store_notice_id")
  shopId        BigInt   @map("shop_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shop        Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  storeNotice StoreNotice @relation(fields: [storeNoticeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([storeNoticeId, shopId])
  @@index([shopId], map: "store_notice_shop_tienda_idx")
  @@map("store_notice_shop")
}

model StoreNoticeRead {
  storeNoticeId BigInt   @map("store_notice_id")
  userId        BigInt   @map("user_id")
  isRead        Boolean  @default(false) @map("is_read")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  storeNotice StoreNotice @relation(fields: [storeNoticeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([storeNoticeId, userId])
  @@index([userId], map: "store_notice_read_usuario_idx")
  @@map("store_notice_read")
}

// =====================================================================
// Cupones (US-52, Épico 46)
// =====================================================================

model Coupon {
  id                BigInt   @id @default(autoincrement())
  code              String   @unique
  description       String?
  image             Json?    @db.Json
  type              String
  amount            Decimal  @db.Decimal
  minimumCartAmount Decimal  @default(0) @map("minimum_cart_amount") @db.Decimal
  activeFrom        DateTime @map("active_from") @db.Timestamptz(6)
  expireAt          DateTime @map("expire_at") @db.Timestamptz(6)
  target            Boolean  @default(false)
  isApprove         Boolean  @default(false) @map("is_approve")
  shopId            BigInt?  @map("shop_id")
  userId            BigInt?  @map("user_id")
  language          String   @default("es")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user User? @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([shopId], map: "coupons_shop_idx")
  @@index([userId], map: "coupons_user_idx")
  @@map("coupons")
}

// =====================================================================
// Lista de deseos (US-53, Épico 46) — pivote usuario ↔ producto
// =====================================================================

model Wishlist {
  userId    BigInt   @map("user_id")
  productId BigInt   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, productId])
  @@index([productId], map: "wishlists_producto_idx")
  @@map("wishlists")
}

// =====================================================================
// Reseñas y reportes de abuso (US-54, Épico 46)
// =====================================================================

model Review {
  id                     BigInt   @id @default(autoincrement())
  orderId                BigInt?  @map("order_id")
  userId                 BigInt   @map("user_id")
  shopId                 BigInt   @map("shop_id")
  productId              BigInt   @map("product_id")
  variationOptionId      BigInt?  @map("variation_option_id")
  comment                String
  rating                 Int      @db.SmallInt
  photos                 Json     @default("[]") @db.Json
  positiveFeedbacksCount Int      @default(0) @map("positive_feedbacks_count")
  negativeFeedbacksCount Int      @default(0) @map("negative_feedbacks_count")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([productId], map: "reviews_producto_idx")
  @@index([shopId], map: "reviews_shop_idx")
  @@map("reviews")
}

/// Polimórfica: (modelType, modelId) apunta a una reseña (o, desde US-55, a
/// una pregunta) sin FK. El repositorio valida que el objeto exista.
model AbusiveReport {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  modelType String   @map("model_type")
  modelId   BigInt   @map("model_id")
  message   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, modelType, modelId])
  @@index([modelType, modelId], map: "abusive_reports_modelo_idx")
  @@map("abusive_reports")
}

// =====================================================================
// Preguntas sobre productos (US-55, Épico 46)
// =====================================================================

model Question {
  id                     BigInt   @id @default(autoincrement())
  userId                 BigInt   @map("user_id")
  shopId                 BigInt   @map("shop_id")
  productId              BigInt   @map("product_id")
  question               String
  answer                 String?
  positiveFeedbacksCount Int      @default(0) @map("positive_feedbacks_count")
  negativeFeedbacksCount Int      @default(0) @map("negative_feedbacks_count")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([productId], map: "questions_producto_idx")
  @@index([shopId], map: "questions_shop_idx")
  @@index([userId], map: "questions_user_idx")
  @@map("questions")
}

// =====================================================================
// Mensajería cliente ↔ tienda (US-56, Épico 46)
// =====================================================================

model Conversation {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  shopId    BigInt   @map("shop_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages Message[]

  @@unique([userId, shopId])
  @@index([shopId], map: "conversations_shop_idx")
  @@map("conversations")
}

model Message {
  id             BigInt   @id @default(autoincrement())
  conversationId BigInt   @map("conversation_id")
  userId         BigInt   @map("user_id")
  body           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)], map: "messages_conversacion_idx")
  @@index([userId], map: "messages_user_idx")
  @@map("messages")
}
