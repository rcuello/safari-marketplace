{
  "name": "@safari/db",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsup",
    "dev": "tsup --watch",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "dotenv": "^16.0.0",
    "prisma": "^7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
