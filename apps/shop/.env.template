FRAMEWORK_PROVIDER="rest"
NEXT_PUBLIC_REST_API_ENDPOINT="http://localhost:9000/api"
NEXT_PUBLIC_GRAPHQL_API_ENDPOINT="http://localhost:4000/graphql"
APPLICATION_MODE=production
NEXT_PUBLIC_ADMIN_URL="your-admin-url"

# Default Language
NEXT_PUBLIC_DEFAULT_LANGUAGE=en

# Multilang
# Before enabling multilingual make sure your API supports multilingual
NEXT_PUBLIC_ENABLE_MULTI_LANG=false
NEXT_PUBLIC_AVAILABLE_LANGUAGES=en

# API Key for third party service

# To configure the payment gateway follow this doc -> https://pickbazar-doc.vercel.app/payment
# Payment -> Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Payment -> Paypal
NEXT_PUBLIC_PAYPAL_CLIENT_TOKEN=

# Payment -> RazorPay
NEXT_PUBLIC_RAZORPAY_KEY=

# Payment -> PayStack
NEXT_PUBLIC_PAYSTACK_KEY=

# Social Authentication
NEXTAUTH_URL=http://localhost:3000
SECRET=
# Login con Google: OPCIONAL (US-70). Vacías, next-auth sigue funcionando y
# el botón «Login with Google» no se ofrece. Con las dos, el botón vuelve,
# pero la API responde con un stub (POST /social-login-token, D-11): hoy el
# login con Google no deja al usuario autenticado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google map API key
NEXT_PUBLIC_GOOGLE_MAP_API_KEY=

# App version

NEXT_PUBLIC_VERSION=11.10.2
