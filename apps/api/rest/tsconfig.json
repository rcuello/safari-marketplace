{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "target": "es2017",
    "strict": false,
    "sourceMap": true,
    "outDir": "./dist",
    "paths": {
      "@db/*": ["./src/db/pickbazar/*"],
      "src/*": ["./src/*"]
    },
    "types": ["node", "express", "multer"],
    "incremental": true,
    "skipLibCheck": true
  }
}
