APP_NAME=Marvel
PORT=9000
DEFAULT_CURRENCY=USD
# do not use / end of this SHOP_URL
SHOP_URL=http://localhost:3003
#### strip api key ---->

STRIPE_API_KEY=

# Payment -> Paypal
# Values: sandbox or live -> sanbox for development and live for production
PAYPAL_MODE=sandbox

#PayPal Setting & API Credentials - sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=

#PayPal Setting & API Credentials - live
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Capa de datos (packages/db). Base local: `just db-up`
DATABASE_URL=postgresql://safari:safari@localhost:5433/safari_scraper

# Autenticación (US-22). `just setup`/`just env` generan un valor real; si
# falta o queda vacío, la API falla al arrancar con un mensaje claro.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Recuperación de contraseña / OTP (US-24). Minutos de vigencia; opcionales
# — un valor ausente o inválido usa el default y solo emite un warning (no
# bloquea el arranque, a diferencia de JWT_SECRET). Ver apps/README.md.
PASSWORD_RESET_TTL_MINUTES=60
OTP_CODE_TTL_MINUTES=10
