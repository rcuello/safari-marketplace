{
  "name": "@marvel-mock/api-rest",
  "version": "11.10.2",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "imports": {
    "#db/*": {
      "types": "./src/db/pickbazar/*",
      "default": "./dist/db/pickbazar/*"
    },
    "#src/*": {
      "types": "./src/*",
      "default": "./dist/*"
    }
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/mapped-types": "12.0.0",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@paypal/checkout-server-sdk": "^1.0.3",
    "@safari/db": "link:../../../packages/db",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "fuse.js": "^6.6.2",
    "nestjs-stripe": "^1.0.0",
    "paypal-rest-sdk": "^1.8.1",
    "qs": "^6.16.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.5.6",
    "stripe": "^11.2.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "12.1.3",
    "@swc/core": "1.16.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.19.43",
    "@types/supertest": "^2.0.12",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "supertest": "^6.2.4",
    "ts-loader": "^9.3.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "unplugin-swc": "2.0.0",
    "vitest": "4.1.11"
  }
}
